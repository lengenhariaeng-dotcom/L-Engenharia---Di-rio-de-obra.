rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isOwner(projectId) {
      return signedIn() && project(projectId).data.ownerUid == request.auth.uid;
    }

    function isClient(projectId) {
      return signedIn() && request.auth.token.email != null &&
             project(projectId).data.clientEmail == request.auth.token.email;
    }

    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email));
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /entries/{entryId} {
        allow read: if isOwner(projectId) || isClient(projectId);
        allow create, update, delete: if isOwner(projectId);
      }
    }
  }
}
